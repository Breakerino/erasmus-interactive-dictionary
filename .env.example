## ------------------------------------------------------------------------------------
## Erasmus Interactive Dictionary | Example
## ------------------------------------------------------------------------------------
## @updated 10/08/2025
## ------------------------------------------------------------------------------------

# ------------------------------------------
# General
# ------------------------------------------

# Project
PROJECT_NAME=erasmus-interactive-dictionary
PROJECT_ENV=[PROJECT_ENV]
PROJECT_VERSION=1.0.0

# Server protocols
APP_SERVER_PROTOCOL=[ADMIN_SERVER_PROTOCOL]
API_SERVER_PROTOCOL=[API_SERVER_PROTOCOL]
ADMIN_SERVER_PROTOCOL=[ADMIN_SERVER_PROTOCOL]

# Server names
APP_SERVER_NAME=[APP_SERVER_NAME]
API_SERVER_NAME=[API_SERVER_NAME]
ADMIN_SERVER_NAME=[ADMIN_SERVER_NAME]

# ------------------------------------------
# Strapi
# ------------------------------------------
STRAPI_HOST=${PROJECT_NAME}-api
STRAPI_PORT=[STRAPI_PORT]
STRAPI_APP_KEYS=[STRAPI_APP_KEYS]
STRAPI_API_TOKEN_SALT=[STRAPI_API_TOKEN_SALT]
STRAPI_ADMIN_JWT_SECRET=[STRAPI_ADMIN_JWT_SECRET]
STRAPI_TRANSFER_TOKEN_SALT=[STRAPI_TRANSFER_TOKEN_SALT]

# ------------------------------------------
# App
# ------------------------------------------
APP_SERVER_HOST=${PROJECT_NAME}-app
APP_SERVER_PORT=[APP_SERVER_PORT]
APP_DEV_SERVER_HOST=[APP_DEV_SERVER_HOST]
APP_DEV_SERVER_PORT=[APP_DEV_SERVER_PORT]
APP_API_BASE_URL=${API_SERVER_PROTOCOL}://${API_SERVER_NAME}

# ------------------------------------------
# Database
# ------------------------------------------
DATABASE_HOST=${PROJECT_NAME}-db
DATABASE_NAME=${PROJECT_NAME}_db
DATABASE_USERNAME=${PROJECT_NAME}_root
DATABASE_PASSWORD=[DATABASE_PASSWORD]
DATABASE_PORT=[DATABASE_PORT]